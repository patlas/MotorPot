#include "tmc2209.h"
#include "stm32f4xx_hal_def.h"
#include "usart.h"

#define TMC_ADDRESS 0U
#define TMC_SYNC 0x05U
#define TMC_WRITE 0x80U
#define TMC_BAUD_TIMEOUT 100U

#define REG_GCONF       0x00U
#define REG_GSTAT       0x01U
#define REG_IOIN        0x06U
#define REG_IHOLD_IRUN  0x10U
#define REG_TPOWERDOWN  0x11U
#define REG_TPWMTHRS    0x13U
#define REG_VACTUAL     0x22U
#define REG_TCOOLTHRS   0x14U
#define REG_SGTHRS      0x40U
#define REG_COOLCONF    0x42U
#define REG_CHOPCONF    0x6CU
#define REG_PWMCONF     0x70U

#define GCONF_VAL 0x000001C0U

static uint8_t tmc_ready;

static uint8_t crc8_wrong(const uint8_t *data, uint8_t length)
{
    uint8_t crc = 0U;
    uint8_t i, bit, byte;
    for (i = 0U; i < length; ++i)
    {
        byte = data[i];
        for (bit = 0U; bit < 8U; ++bit)
        {
            if (((crc >> 7) & 1U) ^ (byte & 1U)) crc = (uint8_t)((crc << 1) ^ 0x07U);
            else crc = (uint8_t)(crc << 1);
            byte >>= 1;
        }
    }
    return crc;
}

static uint8_t crc8(const uint8_t *data, uint8_t length)
{
    uint8_t crc = 0U;
    for (uint8_t i = 0U; i < length; ++i)
    {
        uint8_t byte = data[i];
        for (uint8_t bit = 0U; bit < 8U; ++bit)
        {
            // Kluczowy warunek Trinamic: MSB z aktualnego CRC XORowany z LSB przetwarzanego bajtu danych
            if ((crc >> 7) ^ (byte & 0x01U)) 
            {
                crc = (uint8_t)((crc << 1) ^ 0x07U);
            }
            else 
        {
                crc = (uint8_t)(crc << 1);
            }
            byte >>= 1; // Przejście do kolejnego bitu danych (od LSB do MSB)
        }
    }
    return crc;
}

static void clear_rx(void)
{
    while (__HAL_UART_GET_FLAG(&huart1, UART_FLAG_RXNE)) (void)huart1.Instance->DR; // PATLAS
    // __HAL_UART_FLUSH_DRREGISTER(&huart1);
}

HAL_StatusTypeDef TMC2209_WriteRegister(uint8_t address, uint32_t value)
{
    uint8_t frame[8];
    frame[0] = TMC_SYNC;
    frame[1] = TMC_ADDRESS;
    frame[2] = (uint8_t)(address | TMC_WRITE);
    frame[3] = (uint8_t)(value >> 24);
    frame[4] = (uint8_t)(value >> 16);
    frame[5] = (uint8_t)(value >> 8);
    frame[6] = (uint8_t)value;
    frame[7] = crc8(frame, 7U);
    return HAL_UART_Transmit(&huart1, frame, sizeof(frame), TMC_BAUD_TIMEOUT);
}

HAL_StatusTypeDef TMC2209_ReadRegister(uint8_t address, uint32_t *value)
{
    uint8_t request[4], reply[8];
    HAL_StatusTypeDef status;
    if (value == NULL) return HAL_ERROR;
    clear_rx();
    request[0] = TMC_SYNC;
    request[1] = TMC_ADDRESS;
    request[2] = (uint8_t)(address & 0x7FU);
    request[3] = crc8(request, 3U);
    status = HAL_UART_Transmit(&huart1, request, sizeof(request), TMC_BAUD_TIMEOUT);
    __HAL_UART_FLUSH_DRREGISTER(&huart1);// Clear DR register, rx-tx connected so rx may contain tx data
    if (status != HAL_OK) return status;
    status = HAL_UART_Receive(&huart1, &reply[0], sizeof(reply), TMC_BAUD_TIMEOUT);
    // // Zabezpieczenie przed flagą Overrun
    if (__HAL_UART_GET_FLAG(&huart1, UART_FLAG_ORE)) {
        __HAL_UART_CLEAR_OREFLAG(&huart1);
    }
    uint8_t crc_rep = crc8(&reply[0], 7U);
    if (status != HAL_OK || crc_rep != reply[7]) return HAL_ERROR;
    if ((reply[2] & 0x7FU) != (address & 0x7FU)) return HAL_ERROR;
    *value = ((uint32_t)reply[3] << 24) | ((uint32_t)reply[4] << 16) |
        ((uint32_t)reply[5] << 8) | reply[6];
    return HAL_OK;
}


HAL_StatusTypeDef TMC2209_ReadRegister_bad(uint8_t address, uint32_t *value)
{
    uint8_t request[4], reply[8];
    uint8_t echo_buffer[4]; // Dodatkowy bufor na pochłonięcie echa
    HAL_StatusTypeDef status;

    if (value == NULL) return HAL_ERROR;

    clear_rx(); // Czyszczenie starych śmieci przed transmisją

    request[0] = TMC_SYNC;
    request[1] = TMC_ADDRESS;
    request[2] = (uint8_t)(address & 0x7FU);
    request[3] = crc8(request, 3U);

    // 1. Wysyłanie żądania (4 bajty)
    status = HAL_UART_Transmit(&huart1, request, sizeof(request), TMC_BAUD_TIMEOUT);
    if (status != HAL_OK) return status;

    // 2. POCHŁANIANIE ECHA: natychmiast odbieramy 4 bajty, które sami wysłaliśmy
    // Używamy krótkiego timeoutu, bo te bajty już fizycznie tkwią w buforze sprzętowym
    status = HAL_UART_Receive(&huart1, echo_buffer, sizeof(echo_buffer), 10);
    if (status != HAL_OK) return HAL_ERROR; // Jeśli nie ma echa, coś jest nie tak z połączeniem

    // 3. ODBIÓR WŁAŚCIWEJ ODPOWIEDZI: Teraz odbieramy czyste 8 bajtów od TMC2209
    status = HAL_UART_Receive(&huart1, reply, sizeof(reply), TMC_BAUD_TIMEOUT);
    if (status != HAL_OK) return status;

    // 4. Weryfikacja sumy kontrolnej i adresu odebranej ramki
    if (crc8(reply, 7U) != reply[7]) return HAL_ERROR;
    if ((reply[2] & 0x7FU) != (address & 0x7FU)) return HAL_ERROR;

    // 5. Parsowanie danych (od Bajtu 3 do Bajtu 6)
    *value = ((uint32_t)reply[3] << 24) | ((uint32_t)reply[4] << 16) |
        ((uint32_t)reply[5] << 8)  | reply[6];

    return HAL_OK;
}

static uint8_t current_setting(uint8_t percent)
{
    if (percent > 100U) percent = 100U;
    return (uint8_t)(((uint16_t)percent * 31U) / 100U);
}

HAL_StatusTypeDef TMC2209_Init(void)
{
uint32_t value, value2;
    uint32_t ioin;
    tmc_ready = 0U;
    //if (TMC2209_ReadRegister(REG_IOIN, &ioin) != HAL_OK) return HAL_ERROR;
    //if (((ioin >> 24) & 0xFFU) != 0x21U) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_GCONF, 0x000001C0U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_IHOLD_IRUN,
                              (uint32_t)current_setting(10U) |
                              ((uint32_t)current_setting(90U) << 8) | (1UL << 16)) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_CHOPCONF, 0x14000053) != HAL_OK) return HAL_ERROR; // 0x10000053U
    if (TMC2209_WriteRegister(REG_PWMCONF, 0xC10D0024U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_COOLCONF, 0U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_TPOWERDOWN, 20U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_TPWMTHRS, 0U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_VACTUAL, 0U) != HAL_OK) return HAL_ERROR;
    if (TMC2209_WriteRegister(REG_TCOOLTHRS, 0x20) != HAL_OK) return HAL_ERROR; // 0xFFFFEU
    if (TMC2209_WriteRegister(REG_SGTHRS, 250U) != HAL_OK) return HAL_ERROR; // 40
    if (TMC2209_WriteRegister(REG_GSTAT, 0x02U) != HAL_OK) return HAL_ERROR;
    tmc_ready = 1U;
    TMC2209_Disable();
    return HAL_OK;
}

uint8_t TMC2209_IsReady(void) { return tmc_ready; }

void TMC2209_Enable(void)
{
    if (!tmc_ready) return;
    HAL_GPIO_WritePin(EN_GPIO_Port, EN_Pin, GPIO_PIN_RESET);
    (void)TMC2209_WriteRegister(REG_CHOPCONF, 0x10000053U);
}

void TMC2209_Disable(void)
{
    HAL_GPIO_WritePin(EN_GPIO_Port, EN_Pin, GPIO_PIN_SET);
    if (tmc_ready) (void)TMC2209_WriteRegister(REG_CHOPCONF, 0x10000050U);
}

void TMC2209_SetDirectionInverted(uint8_t inverted)
{
    uint32_t value;
    if (TMC2209_ReadRegister(REG_GCONF, &value) != HAL_OK) return;
    if (inverted) value |= (1UL << 3); else value &= ~(1UL << 3);
    (void)TMC2209_WriteRegister(REG_GCONF, value);
}
